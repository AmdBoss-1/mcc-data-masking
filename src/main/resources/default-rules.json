{
  "struct": [
    { "id": "idcard", "regex": "\\d{17}[\\dXx]",                      "transformer": "idcard" },
    { "id": "taxno",  "regex": "[0-9A-HJ-NP-RTU-WXY]{18}",            "transformer": "taxno" },
    { "id": "plate",  "regex": "[一-龥][A-Z]·?[A-Z0-9]{5,6}",         "transformer": "plate" },
    { "id": "email",  "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "transformer": "email" },
    { "id": "phone",  "regex": "1[3-9]\\d{9}",                        "transformer": "phone" }
  ],
  "columns": {
    "厂名": "factory", "工厂": "factory", "客户": "factory", "供应商": "factory",
    "联系人": "name", "姓名": "name", "司机": "name",
    "地址": "address",
    "电话": "phone", "手机": "phone",
    "车牌": "plate",
    "邮箱": "email",
    "税号": "taxno", "统一社会信用代码": "taxno", "身份证号": "idcard"
  },
  "credentials": ["下载码", "客户码", "私钥", "password", "passwd", "secret", "token"]
}
